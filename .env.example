# Supabase Postgres connection strings.
# Find both under Project Settings -> Database -> Connection string in the Supabase dashboard.

# Pooled connection (via Supavisor/pgbouncer, port 6543) - used at runtime by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - used only by Prisma Migrate to run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to hash session tokens and verification codes (openssl rand -hex 32).
AUTH_SECRET="replace-with-a-long-random-secret"

# Dedicated CAD worker and shared artifact volume. Deploy the worker in an isolated
# Node container with this path mounted on the application service.
GEMINI_API_KEY="replace-with-your-server-side-key"
CAD_ARTIFACT_DIR=".cad-artifacts"

# SMTP credentials for transactional email (password reset codes, etc.).
# If SMTP_HOST is unset, the app falls back to logging the code to the
# server console instead of sending real email (local dev only).
SMTP_HOST="replace-with-your-smtp-host"
SMTP_PORT="587"
SMTP_USER="replace-with-your-smtp-username"
SMTP_PASS="replace-with-your-smtp-password"
MAIL_FROM="no-reply@yourdomain.com"
