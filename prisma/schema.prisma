// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled connection string (port 6543, pgbouncer) here,
  // and the direct (non-pooled) connection string below for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A registered user. Passwords are never stored in plaintext — only a bcrypt hash.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  emailVerifiedAt DateTime? @map("email_verified_at")

  sessions          Session[]
  verificationCodes VerificationCode[]

  @@map("users")
}

// A single logged-in session, identified by an opaque token stored in an
// HTTP-only cookie on the client. The DB only ever sees a hash of the token.
model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_code_purpose")
}

// A short-lived one-time code (e.g. 6-digit code or reset token) sent to a
// user's email for verification or password-reset flows.
model VerificationCode {
  id      String                  @id @default(uuid()) @db.Uuid
  userId  String                  @map("user_id") @db.Uuid
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose VerificationCodePurpose

  codeHash String @map("code_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId, purpose])
  @@map("verification_codes")
}
