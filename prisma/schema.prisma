// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: use the pooled connection string (port 6543, pgbouncer) here,
  // and the direct (non-pooled) connection string below for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A registered user. Passwords are never stored in plaintext — only a bcrypt hash.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  emailVerifiedAt DateTime? @map("email_verified_at")

  sessions          Session[]
  verificationCodes VerificationCode[]
  profile           Profile?
  projects          Project[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?  @map("display_name")
  bio         String?  @db.VarChar(280)
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentRunStatus {
  QUEUED
  PLANNING
  AWAITING_APPROVAL
  EXECUTING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  AWAITING_APPROVAL
}

enum AgentStepType {
  PLAN
  TOOL
  SUBAGENT
  VALIDATION
  OUTPUT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ArtifactKind {
  SOURCE
  INTENT
  PLAN
  PREVIEW_MESH
  STEP
  STL
  AUDIT
  MARKDOWN
  MERMAID
  LATEX
  BLUEPRINT_SVG
  BLUEPRINT_PDF
  BLUEPRINT_DXF
  SKETCH_SVG
  SKETCH_DXF
  THREE_MF
  VALIDATION_REPORT
  AGENT_REPORT
}

model Project {
  id                  String            @id @default(uuid()) @db.Uuid
  ownerId             String            @map("owner_id") @db.Uuid
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug                String            @unique
  title               String
  summary             String?           @db.VarChar(500)
  visibility          ProjectVisibility @default(PRIVATE)
  publishedRevisionId String?           @unique @map("published_revision_id") @db.Uuid
  publishedRevision   Revision?         @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions           Revision[]        @relation("ProjectRevisions")
  jobs                BuildJob[]
  conversations       Conversation[]
  agentRuns           AgentRun[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model Revision {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  project        Project    @relation("ProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)
  revisionNumber Int        @map("revision_number")
  parentId       String?    @map("parent_id") @db.Uuid
  parent         Revision?  @relation("RevisionParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       Revision[] @relation("RevisionParent")
  prompt         String
  intent         Json
  plan           Json
  metrics        Json?
  validation     Json?
  sourceCode     String     @map("source_code")
  isValid        Boolean    @default(false) @map("is_valid")
  artifacts      Artifact[]
  buildJob       BuildJob?
  publishedFor   Project?   @relation("PublishedRevision")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
  @@map("revisions")
}

model BuildJob {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @map("project_id") @db.Uuid
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId String?      @unique @map("revision_id") @db.Uuid
  revision   Revision?    @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  prompt     String
  parentId   String?      @map("parent_id") @db.Uuid
  status     BuildStatus  @default(QUEUED)
  error      String?
  claimedAt  DateTime?    @map("claimed_at")
  startedAt  DateTime?    @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  events     BuildEvent[]
  createdAt  DateTime     @default(now()) @map("created_at")
  agentRun   AgentRun?

  @@index([status, createdAt])
  @@map("build_jobs")
}

model BuildEvent {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  job        BuildJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence   Int
  stage      String
  agent      String
  tool       String?
  summary    String
  detail     Json?
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@map("build_events")
}

model Artifact {
  id         String        @id @default(uuid()) @db.Uuid
  revisionId String        @map("revision_id") @db.Uuid
  revision   Revision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  kind       ArtifactKind
  filename   String
  mimeType   String        @map("mime_type")
  storageKey String        @map("storage_key")
  byteSize   Int           @map("byte_size")
  createdAt  DateTime      @default(now()) @map("created_at")
  outputs    AgentOutput[]

  @@unique([revisionId, kind])
  @@map("artifacts")
}

model AgentRun {
  id              String            @id @default(uuid()) @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentRunId     String?           @map("parent_run_id") @db.Uuid
  parentRun       AgentRun?         @relation("AgentRunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns       AgentRun[]        @relation("AgentRunTree")
  parentMessageId String?           @map("parent_message_id") @db.Uuid
  buildJobId      String?           @unique @map("build_job_id") @db.Uuid
  buildJob        BuildJob?         @relation(fields: [buildJobId], references: [id], onDelete: SetNull)
  kind            String            @default("PRIMARY")
  prompt          String
  title           String?
  model           String?
  reasoningEffort String?           @map("reasoning_effort")
  mode            String            @default("execute")
  status          AgentRunStatus    @default(QUEUED)
  startedAt       DateTime?         @map("started_at")
  finishedAt      DateTime?         @map("finished_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  error           String?
  metadata        Json?
  steps      AgentStep[]
  events     AgentEvent[]
  subagents  AgentSubagent[]
  outputs    AgentOutput[]
  approvals  ApprovalRequest[]
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@map("agent_runs")
}

model AgentStep {
  id          String            @id @default(uuid()) @db.Uuid
  runId       String            @map("run_id") @db.Uuid
  run         AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  parentStepId String?          @map("parent_step_id") @db.Uuid
  parentStep  AgentStep?        @relation("AgentStepTree", fields: [parentStepId], references: [id], onDelete: SetNull)
  childSteps  AgentStep[]       @relation("AgentStepTree")
  sequence    Int
  type        AgentStepType
  status      AgentStepStatus   @default(PENDING)
  agentName   String?           @map("agent_name")
  label       String?
  title       String
  summary     String?
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?              @map("duration_ms")
  startedAt   DateTime?         @map("started_at")
  finishedAt  DateTime?         @map("finished_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  approvals  ApprovalRequest[]
  outputs    AgentOutput[]

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("agent_steps")
}

model AgentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence  Int
  type      String
  summary   String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("agent_events")
}

model AgentSubagent {
  id        String          @id @default(uuid()) @db.Uuid
  runId     String          @map("run_id") @db.Uuid
  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  role      String
  status    AgentStepStatus @default(PENDING)
  summary   String?
  threadRef String?         @map("thread_ref")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([runId, createdAt])
  @@map("agent_subagents")
}

model AgentOutput {
  id         String     @id @default(uuid()) @db.Uuid
  runId      String     @map("run_id") @db.Uuid
  run        AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId     String?    @map("step_id") @db.Uuid
  step       AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  artifactId String?    @map("artifact_id") @db.Uuid
  artifact   Artifact?  @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  kind       String
  inlineBody String?    @map("inline_body")
  mimeType   String?    @map("mime_type")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([runId, createdAt])
  @@map("agent_outputs")
}

model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  runId       String         @map("run_id") @db.Uuid
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId      String?        @map("step_id") @db.Uuid
  step        AgentStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  action      String
  risk        String
  explanation String
  status      ApprovalStatus @default(PENDING)
  decidedAt   DateTime?      @map("decided_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([runId, status])
  @@map("approval_requests")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([projectId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  revisionId     String?      @map("revision_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// A single logged-in session, identified by an opaque token stored in an
// HTTP-only cookie on the client. The DB only ever sees a hash of the token.
model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_code_purpose")
}

// A short-lived one-time code (e.g. 6-digit code or reset token) sent to a
// user's email for verification or password-reset flows.
model VerificationCode {
  id      String                  @id @default(uuid()) @db.Uuid
  userId  String                  @map("user_id") @db.Uuid
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose VerificationCodePurpose

  codeHash String @map("code_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId, purpose])
  @@map("verification_codes")
}
